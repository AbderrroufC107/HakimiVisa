generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  VIEWER
  // A partner agency: signs in to the same app but only ever sees the
  // clients and cases it submitted itself.
  AGENCY
}

enum VisaStatus {
  EN_ATTENTE
  DOSSIER_INCOMPLET
  EN_TRAITEMENT
  RDV_OK
  LIVREE
}

enum TemplateChannel {
  WHATSAPP
  EMAIL
}

enum AppointmentType {
  TLS
  VFS
  EMBASSY
  BIOMETRICS
  INTERVIEW
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  VISA_EXPIRING
  APPOINTMENT_REMINDER
  STATUS_CHANGE
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(AGENT)
  isActive  Boolean  @default(true)
  // Set for AGENCY users; null for the agency's own staff.
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients         Client[]
  visaCases       VisaCase[]
  appointments    Appointment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  statusHistories StatusHistory[]
  notes           Note[]
  refreshTokens   RefreshToken[]
  backups         Backup[]
  deviceTokens    DeviceToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Client {
  id              String   @id @default(cuid())
  fullName        String
  phoneNumber     String
  whatsappNumber  String?
  email           String?
  passportNumber  String? @unique
  passportExpiry  DateTime?
  nationality     String?
  notes           String?
  createdBy       String
  creator         User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visaCases      VisaCase[]
  internalNotes  Note[]
  files          ClientFile[]

  @@index([createdBy])
  @@index([phoneNumber])
  @@map("clients")
}

model ClientFile {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Set when the document belongs to one application rather than the client
  // as a whole. Null keeps the older client-level files working untouched.
  visaCaseId   String?
  visaCase     VisaCase? @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  // Which required document this upload answers. Null for anything the desk
  // adds off its own bat, which is most of what the desk uploads.
  requiredDocumentId String?
  requiredDocument   RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([visaCaseId])
  @@index([requiredDocumentId])
  @@map("client_files")
}

model VisaCase {
  id            String     @id @default(cuid())
  caseNumber    String     @unique
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visaCountry   String
  visaType      String
  currentStatus VisaStatus @default(EN_ATTENTE)
  incompleteReason String?
  archived      Boolean    @default(false)
  openingDate   DateTime   @default(now())
  notes         String?
  price          Float?
  isPaid         Boolean  @default(false)
  createdBy     String
  creator       User       @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Which partner agency sent this case in; null when the desk created it.
  submittedByAgencyId String?
  submittedByAgency   Agency? @relation(fields: [submittedByAgencyId], references: [id], onDelete: SetNull)

  statusHistories StatusHistory[]
  appointments    Appointment[]
  documents       Document[]
  files           ClientFile[]

  @@index([clientId])
  @@index([createdBy])
  @@index([currentStatus])
  @@index([archived])
  @@index([submittedByAgencyId])
  @@map("visa_cases")
}

model Agency {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactPhone String?
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]
  visaCases VisaCase[]

  @@map("agencies")
}

/// The checklist the desk expects with an application. Leaving country or
/// visaType null makes an item apply to everything, the same way a message
/// template with no filters serves every case.
model RequiredDocument {
  id        String   @id @default(cuid())
  label     String
  country   String?
  visaType  String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     ClientFile[]

  @@index([country])
  @@index([visaType])
  @@map("required_documents")
}

model StatusHistory {
  id         String     @id @default(cuid())
  visaCaseId String
  visaCase   VisaCase   @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  oldStatus  VisaStatus
  newStatus  VisaStatus
  changedBy  String
  changer    User       @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  changedAt  DateTime   @default(now())

  @@index([visaCaseId])
  @@index([changedBy])
  @@map("status_histories")
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  url        String   @db.Text
  mimeType   String
  size       Int
  visaCaseId String
  visaCase   VisaCase @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@index([visaCaseId])
  @@index([type])
  @@map("documents")
}

model Appointment {
  id                String          @id @default(cuid())
  visaCaseId        String
  visaCase          VisaCase        @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  appointmentDate   DateTime
  appointmentTime   String
  appointmentCenter String
  appointmentType   AppointmentType
  notes             String?
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([visaCaseId])
  @@index([userId])
  @@index([appointmentDate])
  @@map("appointments")
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

model ClientDeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  phone     String
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([token])
  @@map("client_device_tokens")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(INFO)
  title     String
  message   String
  read      Boolean          @default(false)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AgencySettings {
  id                String   @id @default(cuid())
  agencyName        String
  agencyAddress     String?
  agencyPhone       String?
  agencyEmail       String?
  agencyWebsite     String?
  logoUrl           String?
  defaultCountry    String?
  defaultVisaType   String?
  pdfFooterText     String?
  pdfPrimaryColor   String   @default("#1a73e8")
  appointmentCenter String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("agency_settings")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([createdBy])
  @@map("notes")
}

model Backup {
  id          String   @id @default(cuid())
  filename    String
  size        Int
  status      String   @default("completed")
  type        String   @default("manual")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([createdById])
  @@map("backups")
}

model BackupSettings {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(false)
  frequency      String   @default("daily")
  time           String   @default("02:00")
  retentionDays  Int      @default(30)
  maxBackups     Int      @default(10)
  updatedAt      DateTime @updatedAt

  @@map("backup_settings")
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  @@map("countries")
}

model VisaType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  @@map("visa_types")
}

model TrackingEntry {
  id        String   @id @default(cuid())
  caseNumber String  @unique
  status    String
  location  String?
  timestamp DateTime @default(now())
  message   String?
  updatedAt DateTime @updatedAt

  @@index([timestamp])
  @@map("tracking_entries")
}

model MessageTemplate {
  id              String          @id @default(cuid())
  name            String
  channel         TemplateChannel @default(WHATSAPP)
  country         String?
  visaType        String?
  appointmentType String?
  subject         String?
  body            String          @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("message_templates")
}
